# Never commit a real key. Used by script/Deploy.s.sol.
# Prefer an encrypted keystore with --account and --sender (see docs/DEPLOY-V2.md).
# Optional legacy environment signer; leave unset when using a keystore.
DEPLOYER_PRIVATE_KEY=

# Public Ethereum Sepolia RPC (chain id 11155111). Replace with your own endpoint if you want.
# Do not commit a URL that contains an API key.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional. Only needed for `forge script --verify`. Leave empty in git.
ETHERSCAN_API_KEY=

# Default is real time. Only rental deadlines accelerate; claims always use real hours.
RENTRA_DEMO_MODE=false
