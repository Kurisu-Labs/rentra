# Never commit a real key. Used by script/Deploy.s.sol.
# Hex private key of the account that will broadcast the Ethereum Sepolia deployment.
DEPLOYER_PRIVATE_KEY=

# Public Ethereum Sepolia RPC (chain id 11155111). Replace with your own endpoint if you want.
# Do not commit a URL that contains an API key.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional. Only needed for `forge script --verify`. Leave empty in git.
ETHERSCAN_API_KEY=
