# Privy dashboard app id (exactly 25 characters). Login methods: email + Google.
# Embedded wallet on. Gas sponsorship for Base Sepolia is enabled in the dashboard.
# The default below only lets the UI mount; Masuk needs a real id.
NEXT_PUBLIC_PRIVY_APP_ID=clplaceholderprivyappid01

# Base Sepolia RPC. The public endpoint is fine for the hackathon demo.
NEXT_PUBLIC_BASE_SEPOLIA_RPC=https://sepolia.base.org

# Filled in after `forge script` (see contracts/.env.example). Leave blank to build.
NEXT_PUBLIC_MOCK_IDR_ADDRESS=
NEXT_PUBLIC_RENTAL_ITEM_ADDRESS=
NEXT_PUBLIC_REPUTATION_ADDRESS=
NEXT_PUBLIC_RENTAL_ESCROW_ADDRESS=
