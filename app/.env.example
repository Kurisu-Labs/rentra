# Privy dashboard app id (exactly 25 characters). Login methods: email + Google.
# Embedded wallet on. Gas sponsorship is off unless NEXT_PUBLIC_PRIVY_SPONSOR_GAS=true.
# The default below only lets the UI mount; Masuk needs a real id.
NEXT_PUBLIC_PRIVY_APP_ID=clplaceholderprivyappid01

# Public Ethereum Sepolia RPC (chain id 11155111). No API key.
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# "true" asks Privy to sponsor gas. Default is off: the wallet pays with its own Sepolia ETH.
NEXT_PUBLIC_PRIVY_SPONSOR_GAS=false

# Optional. Env values override contracts/deployments/sepolia.json and app/src/deployments/sepolia.json.
# Leave blank to use the committed Ethereum Sepolia deployment.
NEXT_PUBLIC_MOCK_IDR_ADDRESS=
NEXT_PUBLIC_RENTAL_ITEM_ADDRESS=
NEXT_PUBLIC_REPUTATION_ADDRESS=
NEXT_PUBLIC_RENTAL_ESCROW_ADDRESS=
